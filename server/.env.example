# ===========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kanghoo_db_prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kanghoo_db_prod
DB_USER=postgres
DB_PASSWORD=postgres

# ===========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ===========================================
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRES_IN=24h

# ===========================================
# CONFIGURAÇÕES DE EMAIL
# ===========================================
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ===========================================
# CONFIGURAÇÕES WHATSAPP/TWILIO
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================
PORT=3000
NODE_ENV=development
AUTO_CREATE_TABLES=false

# ===========================================
# CONFIGURAÇÕES DE UPLOAD
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ===========================================
# CONFIGURAÇÕES DE WEBSOCKET
# ===========================================
WS_PORT=3001
WS_HEARTBEAT_INTERVAL=30000

# ===========================================
# CONFIGURAÇÕES DE CACHE
# ===========================================
CACHE_TTL=300000
CACHE_CLEANUP_INTERVAL=600000

# ===========================================
# CONFIGURAÇÕES DE RATE LIMITING
# (alinhadas ao security-middleware)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW=900000
RATE_LIMIT_LOGIN_MAX=5
API_RATE_LIMIT=60
REDIS_URL=

# ===========================================
# CONFIGURAÇÕES DE LOGS
# ===========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===========================================
# CONFIGURAÇÕES DO GOOGLE MAPS
# ===========================================
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui
GOOGLE_MAPS_REGION=BR
GOOGLE_MAPS_LANGUAGE=pt-BR

# ===========================================
# CORS
# ===========================================
# Em produção, especifique origens permitidas separadas por vírgula
# Ex.: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=
