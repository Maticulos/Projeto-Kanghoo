{
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:watch": "node --watch server.js",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "nyc mocha",
    "test:unit": "mocha --grep 'unit'",
    "test:integration": "mocha --grep 'integration'",
    "build": "webpack --mode=production",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*",
    "pre-commit": "lint-staged",
    "start-mock-server": "node mocks/server.js",
    "migrate:latest": "node ./node_modules/knex/bin/cli.js migrate:latest --knexfile ./knexfile.js",
    "migrate:rollback": "node ./node_modules/knex/bin/cli.js migrate:rollback --knexfile ./knexfile.js",
    "seed": "node ../database/run-seed.js",
    "seed:test": "node ../database/run-seed.js",
    "test:server:win": "set AUTO_CREATE_TABLES=true&& mocha"
  },
  "devDependencies": {
    "knex": "^3.1.0",
    "axios": "^1.12.2",
    "chai": "^4.3.7",
    "eslint": "^8.0.0",
    
    "husky": "^8.0.0",
    "jsdom": "^27.0.1",
    "koa-router": "^14.0.0",
    "lint-staged": "^16.2.6",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^2.8.0",
    "sinon": "^15.2.0",
    "supertest": "^7.1.4",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.0.0",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@koa/cors": "^5.0.0",
    "@koa/multer": "^3.0.2",
    "bcrypt": "^6.0.0",
    
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.2",
    "eventemitter3": "^5.0.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-compress": "^5.1.1",
    "koa-json": "^2.0.2",
    "koa-ratelimit": "^6.0.0",
    "koa-static": "^5.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
