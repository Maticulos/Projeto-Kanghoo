# ========================================
# CONFIGURAÇÕES DO AMBIENTE DE DESENVOLVIMENTO
# ========================================

# ========================================
# CONFIGURAÇÕES GERAIS
# ========================================
NODE_ENV=development
PORT=5000
DEMO_MODE=false

# ========================================
# CONFIGURAÇÕES DE SEGURANÇA
# ========================================
JWT_SECRET=sua_chave_secreta_jwt_muito_segura_com_pelo_menos_32_caracteres
SESSION_SECRET=sua_chave_secreta_sessao_diferente_da_jwt

# ========================================
# CONFIGURAÇÕES DE RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_REQUESTS=5

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# Use 'postgres' para Docker Compose
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kanghoo_db_prod
DB_USER=postgres
DB_PASSWORD=postgres

# ========================================
# CONFIGURAÇÕES DE REDIS
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_123

# ========================================
# CONFIGURAÇÕES DE EMAIL
# ========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-app
EMAIL_FROM=noreply@transporteescolar.com

# ========================================
# CONFIGURAÇÕES DO TWILIO PARA WHATSAPP
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ========================================
# CONFIGURAÇÕES DO GOOGLE MAPS
# ========================================
GOOGLE_MAPS_API_KEY=sua_chave_api_google_maps

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# ========================================
# CONFIGURAÇÕES DE CORS
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500

# ========================================
# CONFIGURAÇÕES DE LOGGING
# ========================================
LOG_LEVEL=debug
LOG_DIR=./logs

# ========================================
# CONFIGURAÇÕES DE CACHE
# ========================================
CACHE_TTL=3600

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================
DEBUG=true
HOT_RELOAD=true
LIVE_RELOAD_PORT=35729

# ========================================
# CONFIGURAÇÕES DE TESTE
# ========================================
TEST_DB_NAME=transporte_escolar_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# ========================================
# CONFIGURAÇÕES OPCIONAIS
# ========================================
TZ=America/Sao_Paulo
SESSION_MAX_AGE=7200000

# ========================================
# CONFIGURAÇÕES DE SSL
# ========================================
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# ========================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ========================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
PROMETHEUS_ENABLED=true
