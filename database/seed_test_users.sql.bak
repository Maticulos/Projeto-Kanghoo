-- ==========================================
-- ASSOCIAÇÃO CRIANÇAS <-> ROTAS
-- ==========================================

-- Sofia e Lucas na Rota 1 (Motorista Basic - Carlos)
DO $$
DECLARE
    v_rota_id INTEGER;
    v_sofia_id INTEGER;
    v_lucas_id INTEGER;
BEGIN
    -- Buscar IDs
    SELECT r.id INTO v_rota_id
    FROM rotas_escolares r
    JOIN usuarios u ON r.usuario_id = u.id
    WHERE u.email = 'basic@motorista.com'
    AND r.nome_rota = 'Rota Vila Madalena - Escola Monteiro Lobato'
    LIMIT 1;
    
    SELECT id INTO v_sofia_id FROM criancas WHERE cpf = '12345678901';
    SELECT id INTO v_lucas_id FROM criancas WHERE cpf = '11122233344';
    
    -- Associar Sofia
    IF v_rota_id IS NOT NULL AND v_sofia_id IS NOT NULL THEN
        INSERT INTO criancas_rotas (
            crianca_id, rota_id, endereco_embarque, endereco_desembarque,
            latitude_embarque, longitude_embarque,
            latitude_desembarque, longitude_desembarque,
            horario_embarque_previsto, horario_desembarque_previsto,
            ativo, criado_em
        )
        VALUES (
            v_sofia_id, v_rota_id,
            'Rua dos Jardins, 456 - Jardins, SP',
            'Escola Municipal Monteiro Lobato',
            -23.5615, -46.6565,
            -23.5505, -46.6333,
            '06:45:00', '12:15:00',
            true, NOW()
        )
        ON CONFLICT (crianca_id, rota_id) DO UPDATE SET ativo = true;
    END IF;
    
    -- Associar Lucas
    IF v_rota_id IS NOT NULL AND v_lucas_id IS NOT NULL THEN
        INSERT INTO criancas_rotas (
            crianca_id, rota_id, endereco_embarque, endereco_desembarque,
            latitude_embarque, longitude_embarque,
            latitude_desembarque, longitude_desembarque,
            horario_embarque_previsto, horario_desembarque_previsto,
            ativo, criado_em
        )
        VALUES (
            v_lucas_id, v_rota_id,
            'Av. Faria Lima, 321 - Itaim Bibi, SP',
            'Escola Municipal Monteiro Lobato',
            -23.5875, -46.6822,
            -23.5505, -46.6333,
            '06:50:00', '12:20:00',
            true, NOW()
        )
        ON CONFLICT (crianca_id, rota_id) DO UPDATE SET ativo = true;
    END IF;
END $$;

-- Pedro na Rota 2 (Motorista Premium - Maria)
DO $$
DECLARE
    v_rota_id INTEGER;
    v_pedro_id INTEGER;
BEGIN
    -- Buscar IDs
    SELECT r.id INTO v_rota_id
    FROM rotas_escolares r
    JOIN usuarios u ON r.usuario_id = u.id
    WHERE u.email = 'premium@motorista.com'
    AND r.nome_rota = 'Rota Jardins - Colégio São Francisco'
    LIMIT 1;
    
    SELECT id INTO v_pedro_id FROM criancas WHERE cpf = '98765432109';
    
    -- Associar Pedro
    IF v_rota_id IS NOT NULL AND v_pedro_id IS NOT NULL THEN
        INSERT INTO criancas_rotas (
            crianca_id, rota_id, endereco_embarque, endereco_desembarque,
            latitude_embarque, longitude_embarque,
            latitude_desembarque, longitude_desembarque,
            horario_embarque_previsto, horario_desembarque_previsto,
            ativo, criado_em
        )
        VALUES (
            v_pedro_id, v_rota_id,
            'Rua das Palmeiras, 789 - Moema, SP',
            'Colégio São Francisco',
            -23.5965, -46.6722,
            -23.5615, -46.6565,
            '12:15:00', '17:45:00',
            true, NOW()
        )
        ON CONFLICT (crianca_id, rota_id) DO UPDATE SET ativo = true;
    END IF;
END $$;

-- ==========================================
-- RESUMO FINAL
-- ==========================================

DO $$
DECLARE
    v_motoristas INTEGER;
    v_responsaveis INTEGER;
    v_criancas INTEGER;
    v_rotas INTEGER;
    v_associacoes INTEGER;
BEGIN
    SELECT COUNT(*) INTO v_motoristas 
    FROM usuarios 
    WHERE email IN ('basic@motorista.com', 'premium@motorista.com', 'excursao@motorista.com');
    
    SELECT COUNT(*) INTO v_responsaveis 
    FROM usuarios 
    WHERE email IN ('pai1@email.com', 'pai2@email.com', 'pai3@email.com');
    
    SELECT COUNT(*) INTO v_criancas 
    FROM criancas 
    WHERE cpf IN ('12345678901', '98765432109', '11122233344');
    
    SELECT COUNT(*) INTO v_rotas 
    FROM rotas_escolares r
    JOIN usuarios u ON r.usuario_id = u.id
    WHERE u.email IN ('basic@motorista.com', 'premium@motorista.com');
    
    SELECT COUNT(*) INTO v_associacoes 
    FROM criancas_rotas cr
    JOIN criancas c ON cr.crianca_id = c.id
    WHERE c.cpf IN ('12345678901', '98765432109', '11122233344');
    
    RAISE NOTICE '';
    RAISE NOTICE '╔════════════════════════════════════════════════════════╗';
    RAISE NOTICE '║  ✅ AMBIENTE DE SIMULAÇÃO CRIADO COM SUCESSO!         ║';
    RAISE NOTICE '╚════════════════════════════════════════════════════════╝';
    RAISE NOTICE '';
    RAISE NOTICE '📊 ESTATÍSTICAS:';
    RAISE NOTICE '   🚐 % Motoristas criados', v_motoristas;
    RAISE NOTICE '   👨‍👩‍👧 % Responsáveis criados', v_responsaveis;
    RAISE NOTICE '   👶 % Crianças cadastradas', v_criancas;
    RAISE NOTICE '   🗺️  % Rotas ativas', v_rotas;
    RAISE NOTICE '   🔗 % Associações criança-rota', v_associacoes;
    RAISE NOTICE '';
    RAISE NOTICE '🔐 CREDENCIAIS (Senha: teste123):';
    RAISE NOTICE '';
    RAISE NOTICE '   🚐 MOTORISTAS:';
    RAISE NOTICE '      📧 basic@motorista.com (Plano Basic)';
    RAISE NOTICE '      📧 premium@motorista.com (Plano Premium)';
    RAISE NOTICE '      📧 excursao@motorista.com (Excursão)';
    RAISE NOTICE '';
    RAISE NOTICE '   👨‍👩‍👧 RESPONSÁVEIS:';
    RAISE NOTICE '      📧 pai1@email.com (Sofia, 8 anos)';
    RAISE NOTICE '      📧 pai2@email.com (Pedro, 9 anos)';
    RAISE NOTICE '      📧 pai3@email.com (Lucas, 7 anos)';
    RAISE NOTICE '';
    RAISE NOTICE '╚════════════════════════════════════════════════════════╝';
END $$;
