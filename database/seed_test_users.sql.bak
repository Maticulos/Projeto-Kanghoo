-- Plano Basic para Motorista Escolar
INSERT INTO planos_assinatura (
    usuario_id, tipo_plano, limite_rotas, limite_usuarios, 
    ativo, data_inicio, criado_em
)
SELECT 
    u.id, 
    'basico', 
    3, 
    15,
    true,
    NOW(),
    NOW()
FROM usuarios u
WHERE u.email = 'basic@motorista.com'
ON CONFLICT (usuario_id) DO UPDATE SET 
    tipo_plano = EXCLUDED.tipo_plano,
    ativo = EXCLUDED.ativo;

