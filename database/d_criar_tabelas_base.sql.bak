-- ==========================================
-- CRIAÇÃO DAS TABELAS BASE DO SISTEMA
-- ==========================================
-- Este script cria as tabelas fundamentais necessárias
-- para o funcionamento do sistema de transporte escolar
-- ==========================================

-- Tabela de crianças
CREATE TABLE IF NOT EXISTS criancas (
    id SERIAL PRIMARY KEY,
    nome_completo VARCHAR(255) NOT NULL,
    data_nascimento DATE,
    endereco_residencial TEXT,
    escola VARCHAR(255),
    endereco_escola TEXT,
    responsavel_id INTEGER REFERENCES usuarios(id) ON DELETE CASCADE,
    cpf VARCHAR(14) UNIQUE,
    idade INTEGER,
    nome_responsavel VARCHAR(255),
    telefone_responsavel VARCHAR(20),
    email_responsavel VARCHAR(255),
    ativo BOOLEAN DEFAULT true,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabela de rotas escolares
CREATE TABLE IF NOT EXISTS rotas_escolares (
    id SERIAL PRIMARY KEY,
    usuario_id INTEGER REFERENCES usuarios(id) ON DELETE CASCADE,
    nome_rota VARCHAR(255) NOT NULL,
    descricao TEXT,
    escola_destino TEXT,
    turno VARCHAR(50),
    horario_ida TIME,
    horario_volta TIME,
    dias_semana VARCHAR(50),
    preco_mensal DECIMAL(10,2),
    vagas_disponiveis INTEGER,
    capacidade_maxima INTEGER DEFAULT 15,
    status_rota VARCHAR(50) DEFAULT 'ativa',
    ativa BOOLEAN DEFAULT true,
    ativo BOOLEAN DEFAULT true,
    latitude_origem DECIMAL(10, 8),
    longitude_origem DECIMAL(11, 8),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Índices para melhor performance
CREATE INDEX IF NOT EXISTS idx_criancas_responsavel ON criancas(responsavel_id);
CREATE INDEX IF NOT EXISTS idx_criancas_ativo ON criancas(ativo);
CREATE INDEX IF NOT EXISTS idx_criancas_cpf ON criancas(cpf);

CREATE INDEX IF NOT EXISTS idx_rotas_usuario ON rotas_escolares(usuario_id);
CREATE INDEX IF NOT EXISTS idx_rotas_ativo ON rotas_escolares(ativo);
CREATE INDEX IF NOT EXISTS idx_rotas_status ON rotas_escolares(status_rota);

-- Mensagem de sucesso
DO $$
BEGIN
    RAISE NOTICE '✅ Tabelas base criadas com sucesso!';
    RAISE NOTICE '   - criancas';
    RAISE NOTICE '   - rotas_escolares';
END $$;
